APP_NAME=temp_backend
PORT=8080
APP_ENV=development
LOG_LEVEL=info

MONGO_URI=mongodb://localhost:27017/temp_backend
MONGO_DATABASE=temp_backend
MONGO_CONNECT_TIMEOUT=10s

S3_ENDPOINT_URL=localhost:9000
S3_REGION=us-east-1
S3_BUCKET=temp-bucket
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
S3_PRESIGNED_EXPIRY=15m
S3_PUBLIC_URL=http://localhost:9000

# JWT Configuration
JWT_SECRET=your-256-bit-secret-key-min-32-characters-long-here
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=168h

# Admin Configuration
ADMIN_ACCESS_TOKEN_TTL=30m
ADMIN_REFRESH_TOKEN_TTL=168h
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_DURATION=15m
ADMIN_SETUP_TOKEN_EXPIRY=24h

# Token Configuration
TOKEN_RESEND_COOLDOWN=2m

# SendGrid Email Configuration
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_SENDER_EMAIL=verify@tepbak.com
SENDGRID_ENABLED=true
#SENDGRID_VERIFICATION_TEMPLATE_ID=d-9b0fa24f3c0a4edbb7d5873654942eff
#SENDGRID_PASSWORD_RESET_TEMPLATE_ID=d-24abe7a851db4a169f750ee1ad0d15ff

#Tepbak
SENDGRID_API_KEY=your-sndgrid-api-key
SENDGRID_VERIFICATION_TEMPLATE_ID=<d-verification>
SENDGRID_PASSWORD_RESET_TEMPLATE_ID=<d-reset-template>


# AppSync Event API (for real-time mobile alerts)
# This uses AWS AppSync Event-type API (not GraphQL) for efficient mobile notifications
# Event API is optimized for real-time alerts with lower latency and battery usage
APPSYNC_ENABLED=false
APPSYNC_ENDPOINT=https://<your-appsync-id>.appsync-api.<region>.amazonaws.com/event
APPSYNC_API_KEY=<your-appsync-api-key>
AWS_REGION=us-east-1

# SSE Manager (enabled by default for development)
# Note: Both SSE (Server-Sent Events) and AppSync Events can work together.
# - SSE: For browser/web clients (same-origin connections)
# - AppSync Events: For mobile clients (AWS-hosted, scalable)

# Rate Limiting
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW=1m
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW=1m
RATE_LIMIT_EMAIL_MAX=5
RATE_LIMIT_EMAIL_WINDOW=1h

# Firebase Cloud Messaging (FCM) Configuration
FIREBASE_ENABLED=true
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/path/to/firebase-service-account-key.json

# Notification Configuration
NOTIFICATION_ACTIVITY_COOLDOWN_MINUTES=30
DEVICE_TOKEN_EXPIRY_DAYS=90

# Reporting Configuration
MAX_REPORTS_PER_DAY=10
AUTO_SOFT_DELETE_REPORT_THRESHOLD=15
